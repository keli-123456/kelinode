panel:
  url: "https://panel.example.com"
  token: "your-server-token"
  node_id: 1
  timeout: 15

kernel:
  config_dir: "/etc/v2node"
  log_level: "error"
  ip_strategy: "UseIPv4"
  dns_servers:
    - "1.1.1.1"
    - "8.8.8.8"

log:
  level: "info"
  output: "stdout"
  access: "none"

runtime:
  gomemlimit: "512MiB"
  gogc: 100
  # When enabled, v2node maintains direct iptables REDIRECT rules for HY2
  # external port ranges. Use `v2node rules status` to inspect them.
  auto_hy2_port_forward: false

edge:
  # Experimental local Rust data-plane / sidecar supervisor.
  # Keep disabled until keli-edge is deployed on the same machine.
  enabled: false
  url: "http://127.0.0.1:17990"
  timeout: 2

health_port: 65530
pprof_port: 0

realtime:
  enabled: true
  ping_interval: 30
  reconnect_interval: 5

# Machine mode is opt-in. Old single-node and static multi-node configs keep
# their existing fail-fast startup behavior when this block is omitted.
# machine:
#   enabled: true
#   continue_on_error: true
#   profiles:
#     - name: "site-a"
#       url: "https://panel-a.example.com"
#       token: "machine-token-a"
#       machine_id: 1
#     - name: "site-b"
#       url: "https://panel-b.example.com"
#       token: "machine-token-b"
#       machine_id: 2

# Multi-node example:
# nodes:
#   - node_id: 1
#   - node_id: 2
#     config_dir: "/etc/v2node/node-2"
#
# Static multi-site machine example:
# machine:
#   enabled: true
#   continue_on_error: true
# nodes:
#   - url: "https://panel-a.example.com"
#     token: "panel-a-token"
#     node_id: 1
#     config_dir: "/etc/v2node/panel-a-node-1"
#   - url: "https://panel-b.example.com"
#     token: "panel-b-token"
#     node_id: 8
#     config_dir: "/etc/v2node/panel-b-node-8"
